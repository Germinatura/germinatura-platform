# GERMINATURA - EXEMPLO DE CONFIGURAÇÃO LOCAL DO PORTAL
# Copie para .env.local. Nunca versione segredos reais.

APP_ENV=local
NEXT_PUBLIC_PORTAL_URL=http://127.0.0.1:3000
NEXT_PUBLIC_PDV_URL=http://127.0.0.1:3001
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key

# PDV Pix QR (H2d): receiver of the static Pix BR Code. All three are required; without them the QR is unavailable.
# Use the real PicPay Empresas key only in the environment's configuration, never in the repository.
# PICPAY_PIX_KEY=
# PICPAY_PIX_MERCHANT_NAME=
# PICPAY_PIX_MERCHANT_CITY=
