{
  "name": "germinatura",
  "version": "2.0.0-foundation",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint && node tools/check-eslint-budget.mjs",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "vitest run",
    "test:db": "node tools/run-supabase.mjs test db",
    "test:e2e": "playwright test",
    "test:ci": "pnpm lint && pnpm typecheck && pnpm test:unit && pnpm build",
    "db:generate": "pnpm --filter @germinatura/legacy-db db:generate",
    "legacy-db:start": "docker compose up -d db",
    "legacy-db:push": "pnpm --filter @germinatura/legacy-db exec prisma db push --schema prisma/schema.prisma",
    "supabase:start": "node tools/run-supabase.mjs start",
    "supabase:start:test": "node tools/run-supabase.mjs start -x realtime,storage-api,imgproxy,mailpit,postgres-meta,studio,edge-runtime,logflare,vector,supavisor",
    "supabase:stop": "node tools/run-supabase.mjs stop",
    "supabase:reset": "node tools/run-supabase.mjs db reset",
    "postinstall": "pnpm db:generate"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@playwright/test": "^1.55.0",
    "eslint": "^9.34.0",
    "supabase": "^2.39.2",
    "turbo": "^2.5.8",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vitest": "^3.2.4"
  }
}
