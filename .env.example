# Portal and PDV public configuration
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
NEXT_PUBLIC_PORTAL_URL=http://127.0.0.1:3000
NEXT_PUBLIC_PDV_URL=http://127.0.0.1:3001

# Server-only configuration. Never expose these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/plataforma_vendas
ABACATEPAY_API_KEY=
ABACATEPAY_WEBHOOK_SECRET=
PAYMENTS_ENABLED=false
